---
// お問い合わせダイアログ。data-open="contact" のボタンから site.js が開く。
// 送信は ContactForm（/api/contact/ へ fetch）。
import ContactForm from '../form/ContactForm.astro';
import FormField from '../form/FormField.astro';
import { INQUIRY } from '../../data/contact';
---
<dialog id="contact" aria-labelledby="contact-title">
  <button class="close" aria-label="閉じる">×</button>
  <h2 id="contact-title">{INQUIRY.title}</h2>
  <p class="lead">{INQUIRY.lead}</p>
  <ContactForm kind="inquiry" label={INQUIRY.title} submitLabel={INQUIRY.submit} successMessage={INQUIRY.success}>
    <FormField name="name" label="お名前" required autocomplete="name" />
    <FormField name="email" label="メールアドレス" type="email" required autocomplete="email" inputmode="email" />
    <div class="field-row">
      <FormField name="phone" label="電話番号" type="tel" autocomplete="tel" inputmode="tel" />
      <FormField name="subject" label="件名" />
    </div>
    <FormField name="message" label="内容" type="textarea" required />
  </ContactForm>
</dialog>

<style lang="scss">
dialog {
  width: min(700px, 92vw);
  max-height: 85vh;
  overflow: auto;
  border: 0;
  border-radius: 12px;
  padding: 52px 40px 40px;
  background: var(--paper);
  color: var(--ink);
  box-shadow: 0 20px 80px #17342044;

  &::backdrop {
    background: #102a22a6;
    backdrop-filter: blur(3px);
  }

  h2 {
    font-family: var(--hand);
    color: var(--green);
    font-size: 29px;
    margin-bottom: 12px;
  }

  .lead {
    margin-bottom: 24px;
    font-size: 15px;
  }

  @include mobile {
    padding: 50px 23px 27px;

    h2 {
      font-size: 25px;
    }
  }
}

.close {
  position: absolute;
  right: 14px;
  top: 10px;
  border: 0;
  background: none;
  font-size: 30px;
  width: 40px;
  height: 40px;
}
</style>
