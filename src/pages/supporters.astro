---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Toc from '../components/Toc.astro';
import CtaBar from '../components/CtaBar.astro';
import ContactForm from '../components/form/ContactForm.astro';
import SnsLinks from '../components/SnsLinks.astro';
import FormField from '../components/form/FormField.astro';
import { navItem, SITE_NAME, ORGANIZATION } from '../data/site';
import { MEMBERSHIP } from '../data/contact';

const TITLE = navItem('supporters').label;

// 入会するとできること（本人から受け取った案内文）
const benefits = [
  '後援会活動報告・ニュースレターの配布',
  '各種会合・地域イベントへのご案内',
  'タウンミーティング等での直接対話の機会',
  'SNS（LINE・facebook・Instagram）での最新情報配信',
];
---
<Base title={TITLE} description={`${SITE_NAME}の活動を応援してくださる方の、後援会への入会申し込みを受け付けています。`} current="supporters">
  <Breadcrumb items={[{ label: TITLE }]} />
  <section class="page-hero wrap">
    <div class="page-hero-copy">
      <p class="page-badge">{TITLE}</p>
      <h1>活動を応援してくださる方へ</h1>
      <p class="page-lead">{SITE_NAME}の活動を応援してくださる方の、後援会への入会申し込みを受け付けています。</p>
    </div>
    <div class="page-hero-media"><img src="/assets/supporters.webp" alt="差し出された手を両手で包む場面" /></div>
  </section>
  <div class="page-body wrap">
    <Toc items={[{ id: 'about', label: '後援会について' }, { id: 'join', label: '入会申し込み' }]} />
    <article class="prose">
      <section id="about">
        <h2>後援会について</h2>
        <p>{ORGANIZATION}は、「こうなったらいいな」を1つずつ実現すべく活動する、地域の皆さまとともに歩む後援会です。</p>
        <p>年齢・性別・地域を問わず、南相馬の未来を一緒に考えてくださる方ならどなたでもご入会いただけます。</p>
        <h3>入会された方へ</h3>
        <ul class="bullet-list">{benefits.map((b) => <li>{b}</li>)}</ul>
        <h3>SNSで最新情報を受け取る</h3>
        <p>後援会の活動や催しの案内は、SNSでもお知らせします。</p>
        <SnsLinks />
      </section>
      <section id="join">
        <h2>入会申し込み</h2>
        <p>下の項目を入力して送信してください。内容を確認のうえ、本人からご連絡します。</p>
        <ContactForm kind="membership" label={MEMBERSHIP.title} note={MEMBERSHIP.note} submitLabel={MEMBERSHIP.submit} successMessage={MEMBERSHIP.success}>
          <div class="field-row">
            <FormField name="name" label="お名前" required autocomplete="name" />
            <FormField name="kana" label="ふりがな" required />
          </div>
          <FormField name="postal" label="郵便番号" autocomplete="postal-code" inputmode="numeric" placeholder="9792121" />
          <FormField name="address" label="住所" required autocomplete="street-address" />
          <div class="field-row">
            <FormField name="phone" label="電話番号" type="tel" autocomplete="tel" inputmode="tel" hint="メールアドレスとどちらか必須" />
            <FormField name="email" label="メールアドレス" type="email" autocomplete="email" inputmode="email" hint="電話番号とどちらか必須" />
          </div>
        </ContactForm>
      </section>
    </article>
  </div>
  <CtaBar />
</Base>

<style lang="scss">
// 入会申し込みフォームは本文より少し狭くして読みやすく
:global(.prose) .contact-form {
  max-width: 640px;
  margin-top: 20px;
}
</style>
