---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  current?: 'vision' | 'policies' | 'resources' | 'profile';
  subpage?: boolean;
}

const SITE_NAME = '森山貴士';
const TAGLINE = '南相馬のこれからを、みなさんと。';
const DEFAULT_DESCRIPTION = '困りごとを、放っておかない。南相馬・小高で暮らす一児の父、森山貴士が、子育てや仕事の「不便」を市役所と一緒に直していくための取り組み。';

const { title, description = DEFAULT_DESCRIPTION, current, subpage = true } = Astro.props;
const fullTitle = title ? `${title}｜${SITE_NAME}` : `${SITE_NAME}｜${TAGLINE}`;

const nav = [
  { key: 'vision', label: '考え方', href: '/vision/' },
  { key: 'policies', label: '取り組み', href: '/policies/' },
  { key: 'resources', label: '資料と数字', href: '/resources/' },
  { key: 'profile', label: 'プロフィール', href: '/profile/' },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={subpage ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#234f3d" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Klee+One:wght@400;600&family=Noto+Sans+JP:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class:list={[{ subpage }]}>
    <header class="header">
      <a href="/" class="brand" aria-label={`${SITE_NAME} トップ`}><strong>{SITE_NAME}</strong><span>南相馬のこれからを、<br />みなさんと。</span></a>
      <button class="menu" aria-label="メニューを開く" aria-expanded="false">☰</button>
      <nav aria-label="メインメニュー">
        {nav.map((item) => <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>{item.label}</a>)}
        <button class="button small" data-open="contact">お問い合わせ <span>→</span></button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="wrap footer-main">
        <a class="brand" href="/"><strong>{SITE_NAME}</strong><span>南相馬のこれからを、<br />みなさんと。</span></a>
        <nav aria-label="フッターメニュー">{nav.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
        <a href="#" class="top-link" aria-label="ページ上部に戻る">↑</a>
      </div>
      <div class="wrap footer-bottom"><span>デザイン試作版 · 写真は生成した仮イメージです</span><span>© 2026 {SITE_NAME}</span></div>
    </footer>
    <dialog id="contact" aria-labelledby="contact-title">
      <button class="close" aria-label="閉じる">×</button>
      <h2 id="contact-title">お問い合わせ窓口は準備中です</h2>
      <p>現在はサイトのデザイン試作版です。連絡先が決まり次第、お問い合わせ先をご案内します。</p>
      <p>この画面では入力や送信を受け付けていません。</p>
    </dialog>
    <script src="../scripts/site.js"></script>
  </body>
</html>
