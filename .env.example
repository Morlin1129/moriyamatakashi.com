# お問い合わせ・後援会入会申し込みの送信に使う環境変数。
# ローカルでは .env にコピーして値を入れる（.env は Git に含めない）。
# 本番は Vercel の Project Settings → Environment Variables に同じ名前で設定する。

# Resend の API キー（https://resend.com/api-keys）
RESEND_API_KEY=

# 受け取るメールアドレス
CONTACT_TO=

# 送信元。Resend で検証済みのドメインのアドレスにする
CONTACT_FROM=森山貴士 ウェブサイト <contact@moriyamatakashi.com>

# Cloudflare Turnstile（https://dash.cloudflare.com/?to=/:account/turnstile）
# 下の 2 つは Cloudflare が用意したテスト用のキーで、確認が必ず通る。本番では自分のキーに置き換える
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
