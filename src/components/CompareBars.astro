---
// 複数の市を横棒で並べる（単一色。対象の市だけ濃く、他は薄く）
interface Item { name: string; value: number | null; highlight?: boolean }
interface Props {
  title: string;
  unit: string;
  items: Item[];
  decimals?: number;
  note?: string;
  refLine?: { value: number; label: string }; // 目安の線（例：18%）
}
const { title, unit, items, decimals = 1, note, refLine } = Astro.props;
const max = Math.max(...items.map((i) => i.value ?? 0), refLine?.value ?? 0) || 1;
const fmt = (v: number) => v.toLocaleString('ja-JP', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
---
<figure class="cmp-bars">
  <figcaption><strong>{title}</strong><span>{unit}</span></figcaption>
  <ol>
    {items.map((it) => (
      <li class:list={[{ 'is-target': it.highlight }]}>
        <span class="cmp-name">{it.name}</span>
        <span class="cmp-track">
          {refLine && <span class="cmp-ref" style={`left:${(refLine.value / max) * 100}%`} title={refLine.label}></span>}
          {it.value !== null && <span class="cmp-fill" style={`width:${(it.value / max) * 100}%`}></span>}
        </span>
        <span class="cmp-val">{it.value === null ? '—' : fmt(it.value)}</span>
      </li>
    ))}
  </ol>
  {(note || refLine) && <p class="mini-chart-note">{refLine && <span>点線：{refLine.label}　</span>}{note}</p>}
</figure>

<style lang="scss">
// 近くの市と比べる横棒

.cmp-bars {
  margin: 0;
  background: #fff;
  border: 1px solid $line;
  border-radius: 6px;
  padding: 12px 14px 10px;

  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 14px;
    margin-bottom: 8px;

    span {
      font-size: 12px;
      color: $muted;
    }
  }

  ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 6px;
  }

  li {
    display: grid;
    grid-template-columns: 64px 1fr 56px;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: $muted;

    &.is-target {
      color: var(--ink);
      font-weight: 700;

      .cmp-fill {
        background: var(--green);
      }
    }
  }
}

.cmp-track {
  position: relative;
  height: 12px;
  background: #eef2ea;
  border-radius: 3px;
  overflow: visible;
}

.cmp-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  background: #a9c0a6;
  border-radius: 3px;
}

.cmp-ref {
  position: absolute;
  top: -3px;
  bottom: -3px;
  border-left: 2px dashed $gold;
}

.cmp-val {
  text-align: right;
  font-variant-numeric: tabular-nums;
}

// 注記。MiniChart と同じ見た目で、上の余白だけ少し広い
:global(.prose) .mini-chart-note {
  font-size: 12px;
  color: $muted;
  margin: 8px 0 0;
  line-height: 1.6;
}
</style>
