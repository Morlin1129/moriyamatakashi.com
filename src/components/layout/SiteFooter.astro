---
import Brand from './Brand.astro';
import { NAV, SITE_NAME } from '../../data/site';
---
<footer>
  <div class="wrap footer-main">
    <Brand />
    <nav aria-label="フッターメニュー">{NAV.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
    <a href="#" class="top-link" aria-label="ページ上部に戻る">↑</a>
  </div>
  <div class="wrap footer-bottom"><span>デザイン試作版 · 写真は生成した仮イメージです</span><span>© 2026 {SITE_NAME}後援会</span></div>
</footer>

<style lang="scss">
footer {
  background: var(--green);
  color: #fff;
  padding: 30px 0 20px;
}

.footer-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;

  nav {
    display: flex;
    gap: 25px;
    font-size: 14px;
  }

  @include mobile {
    flex-wrap: wrap;

    nav {
      order: 3;
      flex-wrap: wrap;
      gap: 15px 25px;
    }
  }
}

.top-link {
  border: 1px solid #89a092;
  border-radius: 50%;
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  color: #c9d7ca;
  font-size: 12px;
  margin-top: 25px;

  @include mobile {
    flex-direction: column;
    gap: 8px;
    font-size: 12px;
  }
}
</style>
