---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Toc from '../../components/Toc.astro';
import ResourceCards from '../../components/ResourceCards.astro';
import CtaBar from '../../components/CtaBar.astro';

export async function getStaticPaths() {
  const policies = (await getCollection('policies')).sort((a, b) => a.data.order - b.data.order);
  return policies.map((policy, i) => ({
    params: { id: policy.id },
    props: { policy, prev: policies[i - 1] ?? null, next: policies[i + 1] ?? null },
  }));
}

const { policy, prev, next } = Astro.props;
const p = policy.data;
const { Content, headings } = await render(policy);
// リーフレットの本文（summary）を「概要」として本文の先頭に置く。空行で段落、行の折り返しは PC 表示でだけ <br>
const summaryParagraphs = p.summary.split(/\n\n+/).map((para) => para.split('\n'));
// 目次は「概要」＋本文の ## 見出し。関連する資料は Astro 側で描くので手で足す
const toc = [
  { id: 'summary', label: '概要' },
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: h.text })),
  ...(p.resources?.length ? [{ id: 'sources', label: '関連する資料' }] : []),
];
---
<Base title={p.title} description={p.lead} current="policies">
  <Breadcrumb items={[{ label: '取り組み', href: '/policies/' }, { label: p.title }]} />
  <section class="page-hero wrap">
    <div class="page-hero-copy">
      <p class="page-badge">取り組み {String(p.order).padStart(2, '0')}</p>
      {p.pretitle && <p class="page-pretitle">{p.pretitle}</p>}
      <h1>{p.titleLines.map((line) => <span class="nowrap">{line}</span>)}</h1>
      <p class="page-lead">{p.lead}</p>
    </div>
    <div class="page-hero-media"><img class="crop" src={p.image.src} alt={p.image.alt} /></div>
  </section>
  <div class="page-body wrap">
    <Toc items={toc} />
    <article class="prose">
      <div class="policy-body">
        <!-- <section>
          <h2 id="summary">概要</h2>
          {summaryParagraphs.map((lines) => (
            <p>{lines.map((line, i) => <>{i > 0 && <br class="pc" />}{line}</>)}</p>
          ))}
        </section> -->
        <Content />
      </div>
      {p.resources?.length > 0 && (
        <section id="sources">
          <h2>関連する資料</h2>
          <ResourceCards items={p.resources} />
          <p class="note-small"><a href="/resources/sources/">資料集をすべて見る →</a></p>
        </section>
      )}
    </article>
  </div>
  <nav class="pager wrap" aria-label="ほかの取り組み">
    {prev ? <a class="prev" href={`/policies/${prev.id}/`}><small>← 前の取り組み</small>{prev.data.title}</a> : <span></span>}
    <a class="all" href="/policies/">取り組みの一覧</a>
    {next ? <a class="next" href={`/policies/${next.id}/`}><small>次の取り組み →</small>{next.data.title}</a> : <span></span>}
  </nav>
  <CtaBar />
</Base>

<style lang="scss">
// 取り組み詳細：見出しの上に添える一文（リーフレットの小さな前置き）
.page-pretitle {
  font-size: 15px;
  font-weight: 700;
  color: var(--green);
  margin-bottom: 6px;
}

// 取り組み詳細：前後のページへのリンク

.pager {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 18px;
  align-items: stretch;
  padding-bottom: 56px;

  a {
    display: block;
    background: #fff;
    border-radius: 8px;
    padding: 16px 20px;
    font-weight: 600;
    line-height: 1.6;
    box-shadow: $shadow-card;
    transition: transform 0.2s;

    &:hover {
      transform: translateY(-3px);
    }
  }

  small {
    display: block;
    font-weight: 400;
    color: $green-soft;
    font-size: 13px;
  }

  .next {
    text-align: right;
  }

  .all {
    display: grid;
    place-items: center;
    font-size: 14px;
    color: var(--green);
  }

  @include tablet {
    grid-template-columns: 1fr 1fr;

    .all {
      grid-column: 1/-1;
      grid-row: 2;
      padding: 10px;
    }
  }

  @include mobile {
    grid-template-columns: 1fr;

    .next {
      text-align: left;
    }

    span:empty {
      display: none;
    }
  }
}
</style>
