---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const policies = (await getCollection('policies')).sort((a, b) => a.data.order - b.data.order);

const steps = [
  ['声を聞く', '暮らす人・働く人・育てる人、<br>さまざまな立場の声を聞きます。'],
  ['事実を確かめる', '資料や現場を調べ、<br>課題を整理します。'],
  ['一緒に考える', '立場の違う人たちと、<br>実現できる方法を考えます。'],
  ['小さく試す', 'できるところから試し、<br>良かった点と課題を確かめます。'],
  ['結果を伝え、改善する', '結果をわかりやすく伝え、<br>次につなげます。'],
];
---
<Base subpage={false}>
  <section class="hero">
    <img src="/assets/hero.jpg" alt="地域の人とカフェで話す場面のイメージ" class="hero-photo" fetchpriority="high" />
    <div class="hero-shade"></div>
    <p class="hero-note hand">みんなの声が、<br />まちの力になる。</p>
    <div class="hero-copy">
      <h1 class="hand"><span>現場から、</span><br /><span><em>南相馬</em>のこれからを。</span></h1>
      <p>暮らしの声をよく聴き、事実を確かめ。<br />身近な課題から一つずつ改善し、<br class="mobile" />その結果をわかりやすくお伝えします。</p>
      <a class="button" href="/vision/">私の考え方 <span>→</span></a>
    </div>
    <p class="hero-note bottom hand">ここで暮らす人の<br />話を、これからも。</p>
  </section>

  <section id="vision" class="vision">
    <div class="vision-copy">
      <h2>「もっとこうなればいいのに」を、<br />ひとつずつ。</h2>
      <p class="vision-sub">このまちの頑張りが、暮らしの良さにつながるように。</p>
      <p>地域の声を聞き、実現方法を一緒に考え、<br />結果を確かめる。その積み重ねを大切にします。<br />その土台になるのが、職員が力を発揮できる市役所です。</p>
      <a class="text-link" href="/vision/">考え方を読む <span>→</span></a>
    </div>
    <div class="vision-photo">
      <img src="/assets/portrait.jpg" alt="地域の人と対話する場面のイメージ" loading="lazy" />
      <p class="hand">一人ひとりの声が、<br />まちを動かすはじまりです。</p>
    </div>
  </section>

  <section id="policies" class="policies">
    <div class="wrap">
      <div class="section-top">
        <h2 class="section-heading"><span class="underline">取り組みたい、{policies.length}つのこと</span></h2>
        <a class="more-link" href="/policies/">取り組みの一覧 →</a>
      </div>
      <div class="policy-grid">
        {policies.map((p) => (
          <a class="policy" href={`/policies/${p.id}/`}>
            <span class={`crop crop${p.data.image.crop}`} role="img" aria-label={p.data.image.alt}></span>
            <span class="policy-tag">{p.data.badge}</span>
            <h3>{p.data.title}</h3>
            <span class="short-rule"></span>
          </a>
        ))}
      </div>
    </div>
    <div class="landscape">
      <img src="/assets/landscape.jpg" alt="緑に囲まれた地方のまちのイメージ" loading="lazy" />
      <p class="hand">このまちの、<br />よい未来を一緒につくりたい。</p>
    </div>
  </section>

  <section class="process">
    <div class="wrap process-inner">
      <h2>声を、かたちに。</h2>
      {steps.map(([title, text], i) => (
        <>
          {i > 0 && <span class="step-arrow">→</span>}
          <div class="step"><span class="step-num">{i + 1}</span><h3>{title}</h3><p set:html={text} /></div>
        </>
      ))}
    </div>
  </section>

  <section id="resources" class="resources wrap">
    <div class="resource-intro">
      <h2 class="underline">資料と数字から、まちを考える。</h2>
      <p>事実と私の見方を分けて、<br />考え方の根拠をたどれるようにします。</p>
      <a class="button" href="/resources/">資料集を見る <span>→</span></a>
    </div>
    <div class="resource-card">
      <div class="resource-art paper"><span>南相馬の<br />これからを考える<br /><b>資料ノート</b></span></div>
      <h3>資料を探す</h3>
      <p>取り組みの根拠にしている<br />市の公開資料をまとめています。</p>
      <a class="outline" href="/resources/#sources">資料を見る <span>→</span></a>
    </div>
    <div class="resource-card">
      <div class="resource-art bars"><span class="badge">構想中</span><i></i><i></i><i></i><i></i><i></i></div>
      <h3>税金はどこへ行った？</h3>
      <p>市のお金の使い道を、<br />身近に考えるための道具。</p>
      <a class="outline" href="/resources/#tax">構想を見る <span>→</span></a>
    </div>
    <div class="resource-card">
      <div class="resource-art rings"><span class="badge">構想中</span><span class="ring"></span></div>
      <h3>まちの健康診断</h3>
      <p>人口や産業、暮らしの変化を<br />グラフで見るための道具。</p>
      <a class="outline" href="/resources/#dashboard">構想を見る <span>→</span></a>
    </div>
  </section>

  <section id="profile" class="profile wrap">
    <img src="/assets/portrait.jpg" alt="プロフィール写真の仮イメージ" loading="lazy" />
    <div>
      <h2>森山貴士について</h2>
      <p class="profile-meta">大阪市出身 ／ 2014年 南相馬へ<br />Webエンジニア・地域拠点運営</p>
      <p>ITの仕事を通じて地域の仕事づくりに関わりながら、<br />まちの人たちと一緒に、南相馬のこれからを考えています。<br />現場での対話を大切に、できることから一歩ずつ。</p>
      <a class="button" href="/profile/">森山貴士のプロフィール <span>→</span></a>
    </div>
    <p class="hand profile-note">このまちで出会った<br />人たちと、これからも。</p>
  </section>

  <section class="notes wrap">
    <div class="section-top"><h2>まちを考えるノート</h2><span>取り組みたいことから</span></div>
    <div class="notes-grid">
      <a class="note" href="/vision/"><img src="/assets/hero.jpg" alt="対話のイメージ" loading="lazy" /><small>考え方</small><h3>声を聞いた、その先まで。</h3><p>声を政策に変えるための、3つの難しい仕事。</p></a>
      <a class="note" href="/policies/children/"><span class="crop crop2"></span><small>子ども・子育て</small><h3>「子育て支援が多いまち」から「子育てしたい」まちへ</h3><p>子どもも親も、ここで暮らしたいと思える毎日を。</p></a>
      <a class="note" href="/policies/future/"><img src="/assets/landscape.jpg" alt="まちの風景イメージ" loading="lazy" /><small>まちのこれから</small><h3>施設とお金のことを、みんなで先まで考える。</h3><p>「仕方ない」と言われる前に、一緒に考える。</p></a>
    </div>
  </section>

  <section class="contact-strip">
    <div class="wrap">
      <h2>南相馬のこれからを、<br />一緒に考えませんか？</h2>
      <button class="button" data-open="contact">お問い合わせ・ご意見 <span>→</span></button>
      <p class="hand">小さな声から、<br />大きな一歩へ。</p>
    </div>
  </section>
</Base>
