---
// トップページ：進め方（3ステップ）
const steps = [
  ["話を聞く・知る", "困っている人の話を聞いて、数字や資料も調べます。"],
  ["一緒に考える", "市民、会社、市役所。立場をこえて一緒に考えます。"],
  ["手を動かす", "提案するだけでなく、自分にできることは自分でもやります。"],
];
---

<section id="process" class="process">
  <div class="wrap">
    <h2>どうやって進めるの？</h2>
    <ol class="step-list-top">
      {
        steps.map(([title, text], i) => (
          <li>
            <span class="step-num">{i + 1}</span>
            <div>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="small-link"><a href="/vision/">くわしい考え方 →</a></p>
  </div>
</section>

<style lang="scss">
  .process {
    padding: var(--section-pad) 0;
    background: linear-gradient(120deg, #204735, #285842);
    color: #fff;

    h2 {
      font-size: clamp(24px, 2.4vw, 32px);
      margin-bottom: 28px;

      @include mobile {
        font-size: 24px;
        margin-bottom: 20px;
      }
    }
  }

  .step-list-top {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 28px;

    li {
      display: grid;
      grid-template-columns: 40px 1fr;
      column-gap: 14px;
      row-gap: 6px;
      align-items: start;
    }

    h3 {
      font-size: 24px;
      line-height: 1.6;
      margin: 0 0 8px;
    }

    p {
      font-size: 15px;
      line-height: 1.8;
      color: #ecf2e9;
    }

    @include mobile {
      grid-template-columns: 1fr;
      gap: 22px;
    }
  }

  .step-num {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #fff;
    color: var(--green);
    font-weight: 700;
    font-size: 18px;
    grid-row: span 2;
  }

  // 濃い背景なので明るい色のリンクにする
  .small-link {
    margin-top: 24px;
    font-size: 15px;

    a {
      color: #dfeadf;
      border-bottom: 1px solid $underline;
      border-color: #7f9a86;
    }
  }
</style>
