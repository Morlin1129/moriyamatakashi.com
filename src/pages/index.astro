---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Vision from '../components/home/Vision.astro';
import Voices from '../components/home/Voices.astro';
import Policies from '../components/home/Policies.astro';
import Process from '../components/home/Process.astro';
import ContactStrip from '../components/home/ContactStrip.astro';

const policies = (await getCollection('policies')).sort((a, b) => a.data.order - b.data.order);
---
<Base subpage={false}>
  <Hero />
  <Vision />
  <Voices />
  <Policies policies={policies} />

  <div class="landscape">
    <img src="/assets/landscape.jpg" alt="緑に囲まれた地方のまちのイメージ" loading="lazy" />
  </div>

  <Process />
  <ContactStrip />
</Base>
