---
// トップページ：まちで聞いた声（カード3枚）
// 強調したい語句は <b> で囲む（カード内で緑の太字になる）。<br /> は広い画面だけ効き、狭い画面では自然に折り返す
const voices = [
  '「<b>意見交換会</b>で声を上げても、<br />届いている気がしない」',
  '「地域に不満はない。<br />でも休みの日は、<b>つい市外に<br />遊びに行ってしまう</b>」',
  '「新しい会社の誘致は熱心だけど、<br />ここで根を張ってやる人への<br /><b>応援が少ない</b>」',
];
---
<section id="voices" class="voices">
  <div class="wrap">
    <p class="eyebrow">まちで聞いた声</p>
    <h2>こんな声を、聞いてきました。</h2>
    <ul class="voice-list">
      {voices.map((voice) => (
        <li>
          <svg class="voice-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <path d="M5.7 18.3L4.5 27.5l6-3.5A11 11 0 1 0 5.7 18.3z" />
            <circle cx="11" cy="14.5" r="1.4" /><circle cx="16" cy="14.5" r="1.4" /><circle cx="21" cy="14.5" r="1.4" />
          </svg>
          <p set:html={voice} />
        </li>
      ))}
    </ul>
    <div class="voices-close">
      <p>こうした声を、放っておきたくない。<br /><strong>ひとつずつ、形にしていきます。</strong></p>
      <a class="button outline" href="#policies">取り組みを見る <span>→</span></a>
    </div>
  </div>
</section>

<style lang="scss">
.voices {
  padding: var(--section-pad) 0;

  h2 {
    font-size: clamp(28px, 3.2vw, 40px);
    margin-bottom: 36px;

    @include mobile {
      font-size: 28px;
      margin-bottom: 26px;
    }
  }
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 22px;
  font-size: 15px;
  font-weight: 700;
  color: var(--green);
  margin-bottom: 14px;

  &:before {
    content: '';
    width: 48px;
    height: 3px;
    background: var(--green);
    border-radius: 2px;
  }
}

.voice-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;

  li {
    background: #fff;
    border: 1px solid #dde4d8;
    border-radius: 10px;
    padding: 36px 28px 40px;
  }

  p {
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.85;
    padding-left: 0.5em;
    text-indent: -0.5em;
  }

  // <b> と <br> は set:html で差し込むのでスコープ属性が付かない。:global で拾う
  :global(b) {
    color: var(--green);
    font-weight: 700;
  }

  @include narrow-nav {
    grid-template-columns: 1fr;

    :global(br) {
      display: none;
    }

    p {
      font-size: 17px;
    }
  }

  @include mobile {
    grid-template-columns: 1fr;
    gap: 14px;

    li {
      padding: 26px 22px 28px;
    }

    p {
      font-size: 16px;
    }
  }
}

.voice-icon {
  display: block;
  width: 46px;
  height: 46px;
  margin-bottom: 26px;
  color: var(--green);
  fill: none;
  stroke: currentColor;
  stroke-width: 1.6;
  stroke-linejoin: round;

  circle {
    fill: currentColor;
    stroke: none;
  }

  @include mobile {
    width: 38px;
    height: 38px;
    margin-bottom: 18px;
  }
}

.voices-close {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
  margin-top: 48px;
  padding-top: 44px;
  border-top: 1px solid #d9e0d5;

  p {
    font-size: 26px;
    line-height: 1.7;
    font-weight: 700;
  }

  strong {
    color: var(--green);
  }

  @include mobile {
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    margin-top: 36px;
    padding-top: 32px;

    p {
      font-size: 21px;
    }

    .button {
      width: 100%;
    }
  }
}
</style>
