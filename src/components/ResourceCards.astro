---
interface Props {
  items: { title: string; url: string; note: string; tag?: string; cat?: string }[];
  id?: string;
}
const { items, id } = Astro.props;
---
<ul class="resource-cards" id={id}>
  {items.map((r) => (
    <li data-cat={r.cat}>
      <a href={r.url} target="_blank" rel="noopener">
        <span class="doc-icon" aria-hidden="true"></span>
        <span>
          {r.tag && <span class="cat-tag">{r.tag}</span>}
          <strong>{r.title}</strong>
          <small>{r.note}</small>
          <em>資料の要点・原本を確認する →</em>
        </span>
      </a>
    </li>
  ))}
</ul>

<style lang="scss">
.resource-cards {
  list-style: none;
  padding: 0;
  margin: 0 0 14px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;

  a {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 14px;
    padding: 16px 18px;
    background: #fff;
    border: 1px solid $line;
    border-radius: 6px;
    height: 100%;
    transition: transform 0.2s, box-shadow 0.2s;

    &:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px #20492b14;
    }
  }

  strong {
    display: block;
    font-size: 15px;
    line-height: 1.6;
  }

  small {
    display: block;
    font-size: 13px;
    color: $muted;
    line-height: 1.7;
    margin: 4px 0 6px;
  }

  em {
    font-style: normal;
    font-size: 13px;
    color: var(--green);
    font-weight: 600;
  }

  @include mobile {
    grid-template-columns: 1fr;
  }
}

.doc-icon {
  width: 32px;
  height: 38px;
  border: 2px solid var(--green);
  border-radius: 4px;
  position: relative;
  margin-top: 2px;

  &:before,
  &:after {
    content: '';
    position: absolute;
    left: 6px;
    right: 6px;
    height: 2px;
    background: var(--green);
    top: 12px;
  }

  &:after {
    top: 20px;
    right: 12px;
  }
}
</style>
