---
// トップページ：ファーストビュー
---
<section class="hero">
  <img src="/assets/hero.webp" alt="地域の人とカフェで話す場面のイメージ" class="hero-photo" fetchpriority="high" />
  <div class="hero-shade"></div>
  <div class="hero-copy">
    <h1 class="hand"><span>「こうなったらいいな」</span><br /><span>を、ひとつずつ。</span></h1>
  </div>
</section>

<style lang="scss">
.hero {
  height: min(720px, 61vw);
  min-height: 560px;
  position: relative;
  isolation: isolate;
  color: white;
  overflow: hidden;

  h1 {
    font-size: clamp(20px, 3vw, 48px);
    line-height: 1.7;
    color: #1d2720;
    transform: rotate(-3deg);

    span {
      display: inline-block;
      background: #fffdf7;
      padding: 0 15px 4px;
      box-shadow: 0 2px 10px #14271a0a;
      max-width: 100%;
      margin-bottom: 6px;

      + span {
        margin-top: 12px;
      }
    }

    em {
      color: var(--green);
      font-style: normal;
    }
  }

  // 下端を紙の色でギザギザに切る
  &:after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: -5%;
    width: 110%;
    height: 23px;
    background: var(--paper);
    clip-path: polygon(0 45%, 30% 90%, 70% 60%, 100% 0, 100% 100%, 0 100%);
  }

  @include wide {
    height: 760px;
  }

  @include mobile {
    height: 660px;
    min-height: 0;

    h1 {
      font-size: clamp(24px, 4vw, 42px);
      line-height: 1.85;

      span {
        padding: 0 9px 3px;
      }
    }
  }
}

.hero-photo {
  height: 100%;
  object-position: center 48%;
  position: absolute;
  z-index: -3;

  // 人物が写真の中央にいるので、縦長の枠でも顔が見出しの上に収まるよう中央に寄せる
  @include mobile {
    object-position: 48% center;
  }
}

.hero-shade {
  position: absolute;
  inset: 0;
  z-index: -2;
  background: linear-gradient(90deg, #10231cc0, transparent 78%), linear-gradient(0deg, #10231c55, transparent 40%);

  @include mobile {
    background: linear-gradient(0deg, #172c23bd, transparent 85%);
  }
}

.hero-copy {
  position: absolute;
  left: 5%;
  bottom: 70px;
  max-width: 640px;

  @include mobile {
    left: 5%;
    right: 5%;
    bottom: 45px;
  }
}

</style>
