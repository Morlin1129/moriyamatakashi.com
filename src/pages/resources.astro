---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolCard from '../components/ToolCard.astro';
import CtaBar from '../components/CtaBar.astro';
import { navItem } from '../data/site';
import { TOOLS } from '../data/tools';

const nav = navItem('resources');
---
<Base title={nav.label} description="南相馬の数字を触って考えるミニアプリと、政策の根拠にしている公開資料の資料集。" current="resources">
  <Breadcrumb items={[{ label: nav.label }]} />
  <section class="page-hero wrap">
    <div class="page-hero-copy">
      <p class="page-badge">{nav.label}</p>
      <h1><span class="nowrap">資料と数字から、</span><span class="nowrap">まちを考える。</span></h1>
      <p class="page-lead">事実と私の見方を分けて、考え方の根拠をたどれるようにします。</p>
    </div>
    <div class="page-hero-media"><div class="resource-art paper"><span>南相馬の<br />これからを考える<br /><b>資料ノート</b></span></div></div>
  </section>
  <div class="tools-body wrap">
    <p class="tools-intro">選挙や政策を考える「参考材料」として、事実（データ）を並べて一緒に考えるための道具と、その根拠になる資料をまとめています。数字の出典と計算方法・注意点は各ページ内に示しています。</p>
    <div class="tool-grid">
      {TOOLS.map((tool) => <ToolCard tool={tool} />)}
    </div>
  </div>
  <CtaBar />
</Base>

<style lang="scss">
// まちを知る：ミニアプリと資料集のカード一覧

.tools-body {
  padding-bottom: 64px;
}

.tools-intro {
  max-width: 720px;
  font-size: 15px;
  line-height: 1.95;
  margin-bottom: 28px;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;

  @include mobile {
    grid-template-columns: 1fr;
  }
}
</style>
