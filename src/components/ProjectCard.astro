---
// 主要事業のカード。年表から #project-<id> でリンクされる。
import type { Project } from '../data/odaka-types';
interface Props { project: Project }
const { project: p } = Astro.props;
const STATUS: Record<Project['status'], string> = {
  done: '完成・稼働中',
  building: '整備中',
  planned: '計画中',
  suspended: '中断・見直し',
};
const period = !p.end ? `${p.start}年〜` : p.end === p.start ? `${p.start}年` : `${p.start}年〜${p.end}年`;
---
<article class={`project-card is-${p.status}`} id={`project-${p.id}`}>
  <p class="pc-tags">
    <span class="pc-cat">{p.category}</span>
    <span class="pc-status">{STATUS[p.status]}</span>
    {!p.verified && <span class="tl-unverified">資料未確認</span>}
  </p>
  <h3>{p.name}</h3>
  <p class="pc-period">{period}</p>
  <p>{p.summary}</p>
  {p.body && <p class="pc-detail">{p.body}</p>}
  {p.current.length > 0 && (
    <dl class="pc-current">
      {p.current.map((c) => (
        <div>
          <dt>{c.label}</dt>
          <dd>{c.value}<small>{c.asOf}時点 · <a href={c.source} target="_blank" rel="noopener" aria-label={`${c.label}（${c.asOf}）の出典`}>出典↗</a></small></dd>
        </div>
      ))}
    </dl>
  )}
  {p.sources.length > 0 && (
    <p class="pc-links">{p.sources.map((s) => <a href={s.url} target="_blank" rel="noopener">{s.title}↗</a>)}</p>
  )}
</article>

<style lang="scss">
// 小高 復興のあゆみ: 事業カード

.project-card {
  background: #fff;
  border-radius: 8px;
  padding: 18px 20px 8px;
  box-shadow: $shadow-card;
  scroll-margin-top: 24px;
  // 長いURLや英数字列で横にあふれないようにする
  min-width: 0;
  overflow-wrap: anywhere;

  &.is-done .pc-status {
    background: $sage;
    color: var(--green);
  }

  &.is-building .pc-status {
    background: $gold-bg;
    color: $gold-text-dark;
  }

  &.is-planned .pc-status {
    background: $gray-bg;
    color: $muted-dark;
  }

  &.is-suspended .pc-status {
    background: $red-bg;
    color: $red-text;
  }
}

.pc-cat,
.pc-status {
  @include pill;
}

// 年表と同じ「資料未確認」ラベル
.tl-unverified {
  @include pill;
  background: $red-bg;
  color: $red-text;
}

// 親ページの .prose はこのコンポーネントの外なので :global で拾う
:global(.prose) .project-card {
  h3 {
    font-size: 18px;
    margin: 0 0 2px;
    line-height: 1.6;
  }

  p {
    font-size: 15px;
    line-height: 1.85;
    margin-bottom: 0.6em;
  }

  p.pc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 6px;
  }

  p.pc-period {
    font-size: 13px;
    color: $muted;
  }

  p.pc-detail {
    font-size: 14px;
    color: $muted-dark;
  }

  p.pc-links {
    font-size: 13px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
  }
}

.pc-links a {
  color: var(--green);
}

// 現在の数字（定義リスト）
.pc-current {
  margin: 0 0 0.8em;
  padding: 12px 14px;
  background: $tint;
  border: 1px solid $line;
  border-radius: 6px;
  display: grid;
  gap: 8px;

  div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  dt {
    font-size: 13px;
    color: $muted;
  }

  dd {
    margin: 0;
    font-weight: 700;
    text-align: right;
  }

  small {
    display: block;
    font-size: 11px;
    font-weight: 400;
    color: $muted;

    a {
      color: var(--green);
    }
  }
}
</style>
