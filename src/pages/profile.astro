---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Toc from '../components/Toc.astro';
import CtaBar from '../components/CtaBar.astro';

const career = [
  ['出身', '大阪市'],
  ['学歴', '立命館大学 政策科学部 卒業'],
  ['2014年', '南相馬市小高区へ移住'],
  ['仕事', 'Webエンジニア／業務改善（BPR）コンサルティング'],
  ['地域活動', '一般社団法人オムスビ 代表理事、地域拠点 AOSUBASHI を運営'],
  ['受賞', '令和4年度「新しい東北」復興・創生の星顕彰'],
];
---
<Base title="プロフィール" description="森山貴士のプロフィール。大阪市出身、2014年に南相馬市小高区へ移住。" current="profile">
  <Breadcrumb items={[{ label: 'プロフィール' }]} />
  <section class="page-hero wrap">
    <div class="page-hero-copy">
      <p class="page-badge">プロフィール</p>
      <h1>森山貴士について</h1>
      <p class="page-lead">大阪市出身 ／ 2014年 南相馬へ。Webエンジニア・地域拠点運営。</p>
    </div>
    <div class="page-hero-media"><img src="/assets/profile.webp" alt="森山貴士のプロフィール写真" class="profile-photo" /></div>
  </section>
  <div class="page-body wrap">
    <Toc items={[{ id: 'about', label: '森山貴士について' }, { id: 'career', label: '経歴' }]} />
    <article class="prose">
      <section id="about">
        <h2>ごあいさつ</h2>
        <p>みなさんこんにちは。森山です。「オムスビの森山」や「アオスバシの森山」として知ってくださっている方もいるかと思いますが、小高を拠点に、カフェ・小売・コワーキングスペースを併設した「アオスバシ」の運営などを行う一般社団法人オムスビの代表理事を務めています。</p>
        <p>そのかたわら、システム開発や業務改善、事業支援の仕事にも取り組んでいます。生計はこちらがメインです。</p>
        <p>2014年に南相馬市に移住し、13年目になります。結婚し、子どもが産まれ、現在は一児の父です。</p>
        <p>人の話を聞き、課題を整理し、できる形にする。思えば仕事も地域の活動もこうしたことをずっとやってきました。</p>
        <p>これまで地域や企業に対してやってきたことを、</p>
        <p>市政の取り組みにもつなげていきたいと考えています。</p>
        <p>地域の人たちの「こうなったらいいな」を一つずつ、実現していける市政に取り組んでまいります。</p>

      </section>
      <section id="career">
        <h2>経歴</h2>
        <dl class="career">{career.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
      </section>
      <p class="next-link"><a class="button" href="/vision/">考え方を読む <span>→</span></a></p>
    </article>
  </div>
  <CtaBar />
</Base>

<style lang="scss">
// 枠のほうが横長で上下が切れるため、頭が切れないよう上寄せにする
.profile-photo {
  object-position: center 22%;
}

// プロフィール：経歴

.career {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 0;
  margin: 0;

  dt,
  dd {
    padding: 12px 0;
    border-top: 1px solid $line-soft;
    margin: 0;
  }

  dt {
    font-weight: 700;
    color: $green-soft;
    padding-right: 28px;
    white-space: nowrap;
  }

  @include mobile {
    grid-template-columns: 1fr;

    dt {
      padding-bottom: 0;
    }

    dd {
      border-top: 0;
      padding-top: 4px;
    }
  }
}
</style>
