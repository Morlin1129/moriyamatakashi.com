---
// 小さなグラフを2列（one なら1列）に並べる枠
interface Props {
  one?: boolean;
}
const { one = false } = Astro.props;
---
<div class:list={['chart-grid', { one }]}><slot /></div>

<style lang="scss">
.chart-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
  margin: 0 0 1.2em;

  &.one {
    grid-template-columns: 1fr;
    max-width: 480px;
  }

  // 長いURLや英数字列で横にあふれないようにする（子は別コンポーネントなので :global）
  > :global(.mini-chart) {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  @include mobile {
    grid-template-columns: 1fr;
  }
}
</style>
