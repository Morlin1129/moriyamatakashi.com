---
import Brand from './Brand.astro';
import { NAV, SITE_NAME, type NavKey } from '../../data/site';

interface Props {
  current?: NavKey;
}
const { current } = Astro.props;
---
<header class="header">
  <Brand label={`${SITE_NAME} トップ`} />
  <button class="menu" aria-label="メニューを開く" aria-expanded="false">☰</button>
  <nav aria-label="メインメニュー">
    {NAV.map((item) => <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>{item.label}</a>)}
    <button class="button small" data-open="contact">お問い合わせ <span>→</span></button>
  </nav>
</header>

<style lang="scss">
.header {
  background: rgba(250, 249, 243, 0.98);
  height: 92px;
  padding: 0 4%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;

  nav {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 14px;
    font-weight: 600;

    > a:hover {
      color: $green-link;
    }

    a[aria-current='page'] {
      color: $green-link;
      box-shadow: inset 0 -2px 0 $green-link;
    }

    @include narrow-nav {
      gap: 15px;
    }

    // スマホではハンバーガーで開閉するドロップダウンになる（.open は site.js が付ける）
    @include mobile {
      display: none;
      position: absolute;
      top: 74px;
      left: 0;
      right: 0;
      background: var(--paper);
      padding: 24px;
      box-shadow: 0 10px 15px #19351a1a;
      flex-direction: column;
      align-items: stretch;
      gap: 16px;

      &.open {
        display: flex;
      }

      > a {
        padding: 8px;
      }
    }
  }

  @include mobile {
    height: 74px;
    padding: 0 5%;
    position: relative;
    z-index: 10;
  }
}

// ハンバーガーメニュー（スマホのみ）
.menu {
  display: none;

  @include mobile {
    display: block;
    background: none;
    border: 1px solid #c7d2c4;
    border-radius: 5px;
    width: 44px;
    height: 44px;
    font-size: 23px;
  }
}
</style>
