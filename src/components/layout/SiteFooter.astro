---
import Brand from './Brand.astro';
import { NAV, SNS, ORGANIZATION, PRIVACY } from '../../data/site';
---
<footer>
  <div class="wrap footer-main">
    <Brand />
    <nav aria-label="フッターメニュー">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
      <span class="sep" aria-hidden="true"></span>
      {SNS.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.name}</a>)}
    </nav>
    <a href="#" class="top-link" aria-label="ページ上部に戻る">↑</a>
  </div>
  <div class="wrap footer-bottom"><span><a href={PRIVACY.href}>{PRIVACY.label}</a> · © 2026 {ORGANIZATION}</span></div>
</footer>

<style lang="scss">
footer {
  background: var(--green);
  color: #fff;
  padding: 30px 0 20px;
}

.footer-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;

  nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 25px;
    font-size: 14px;

    // 幅が足りないときは項目の途中で折れず、項目ごとに次の行へ送る
    a {
      white-space: nowrap;
    }
  }

  // ページのリンクと SNS のリンクの区切り
  .sep {
    width: 1px;
    height: 14px;
    background: #89a092;

    @include mobile {
      display: none;
    }
  }

  @include mobile {
    flex-wrap: wrap;

    nav {
      order: 3;
      flex-wrap: wrap;
      gap: 15px 25px;
    }
  }
}

.top-link {
  border: 1px solid #89a092;
  border-radius: 50%;
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  color: #c9d7ca;
  font-size: 12px;
  margin-top: 25px;

  a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @include mobile {
    flex-direction: column;
    gap: 8px;
    font-size: 12px;
  }
}
</style>
